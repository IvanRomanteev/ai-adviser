{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG search request",
  "type": "object",
  "required": ["id", "queries"],
  "properties": {
    "id": { "type": "string" },
    "max_sources": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
    "min_score": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.8 },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
